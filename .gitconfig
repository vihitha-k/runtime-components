[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Vihitha Kumar
	email = vihithakumar@gmail.com
[init]
	defaultBranch = main
[core]
	editor = vim
[pull]
	rebase = true

# ~/.gitconfig: read by git every time it runs.

[init]
	defaultBranch = main

[core]
	editor = vim

[pull]
	rebase = true

[color]
	ui = auto

# Aliases: `git st` runs `git status`, and so on.
[alias]
	st = status
	br = branch
	sw = switch
	last = log -1 HEAD --stat
	# One line per commit, with a branch graph:
	lg = log --oneline --graph --decorate --all
	# Undo `git add file` (keeps your edits, just unstages them):
	unstage = restore --staged --

